<?xml version="1.0" encoding="utf-8"?>
<!--
    The one place native dimensions live. Layouts and styles must reference
    these names instead of repeating a dp value by hand.
-->
<resources>
    <!-- Screen & card padding -->
    <dimen name="levix_space_screen">20dp</dimen>
    <dimen name="levix_space_screen_h">16dp</dimen>
    <dimen name="levix_space_screen_bottom">40dp</dimen>
    <dimen name="levix_card_padding">14dp</dimen>
    <dimen name="levix_card_padding_compact">16dp</dimen>
    <dimen name="levix_card_padding_large">20dp</dimen>

    <!-- Gaps -->
    <dimen name="levix_gap_xs">4dp</dimen>
    <dimen name="levix_gap_sm">6dp</dimen>
    <dimen name="levix_gap_md">10dp</dimen>
    <dimen name="levix_gap_lg">12dp</dimen>
    <dimen name="levix_gap_xl">18dp</dimen>

    <!-- Icons & touch targets -->
    <dimen name="levix_icon_sm">20dp</dimen>
    <dimen name="levix_icon_md">24dp</dimen>
    <dimen name="levix_icon_lg">28dp</dimen>
    <dimen name="levix_icon_button">48dp</dimen>
    <dimen name="levix_icon_button_sm">36dp</dimen>
    <dimen name="levix_button_min_height">48dp</dimen>
    <dimen name="levix_button_min_height_assist">46dp</dimen>
    <dimen name="levix_button_min_height_compact">38dp</dimen>

    <!-- Corner radii: mirror the shape drawables, one name per family. -->
    <dimen name="levix_radius_card">18dp</dimen>
    <dimen name="levix_radius_raised">14dp</dimen>
    <dimen name="levix_radius_badge">8dp</dimen>
    <dimen name="levix_radius_pill">999dp</dimen>
</resources>
