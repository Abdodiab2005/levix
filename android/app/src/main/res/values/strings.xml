<resources>
    <string name="app_name">Levix</string>

    <!-- Home tour: every stop spotlights the real control it describes, in the
         order an operator meets them. A hidden control is skipped, so bodies
         must read as sentences about the highlighted button, not about order. -->
    <string name="guide_step">Step %1$d of %2$d</string>
    <string name="guide_start_title">Start your assistant</string>
    <string name="guide_start_body">This circle starts Levix. Allow notifications when asked so the assistant can keep running while the screen is off.</string>
    <string name="guide_battery_title">Keep it running</string>
    <string name="guide_battery_body">When this card shows a restriction, tap Enable Battery Guard and choose Unrestricted. Without it, Android may stop Levix while the screen is locked.</string>
    <string name="guide_panel_title">Open the control panel</string>
    <string name="guide_panel_body">This button connects WhatsApp and later opens the panel. Choose a password on first use; commands, the AI and group settings all live there.</string>
    <string name="guide_link_title">Check WhatsApp</string>
    <string name="guide_link_body">This card shows whether WhatsApp is linked. Tap it for the full status; to link your phone, open the panel, go to Connection and request a pairing code.</string>
    <string name="guide_media_title">Media Hub</string>
    <string name="guide_media_body">Media Hub browses the WhatsApp statuses, photos, videos and voice notes stored on this phone. Nothing leaves the phone, and you choose what to save.</string>
    <string name="guide_privacy_title">Privacy and diagnostics</string>
    <string name="guide_privacy_body">Levix runs on this phone and talks only to WhatsApp and the services you enable. Logs and crash reports wait here until you save, share or delete them.</string>
    <string name="guide_header_title">Language and appearance</string>
    <string name="guide_header_body">These two icons switch between Arabic and English, and between light and dark. Levix remembers your choice.</string>
    <string name="guide_skip">Skip</string>
    <string name="guide_back">Back</string>
    <string name="guide_next">Next</string>
    <string name="guide_done">Done</string>
    <string name="guide_again_title">Show guide again</string>
    <string name="guide_again_sub">Replay this tour of the home screen</string>
