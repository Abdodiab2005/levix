<?xml version="1.0" encoding="utf-8"?>
<!-- The restricted-battery banner: filled and bordered so it reads as a
     standing warning, not as one more card in the column. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/levix_warn_soft" />
    <stroke
        android:width="1dp"
        android:color="@color/levix_warn" />
    <corners android:radius="18dp" />
</shape>
