<?xml version="1.0" encoding="utf-8"?>
<!-- Guide art, step 2: the restricted-battery banner and its filled action. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="200dp"
    android:height="125dp"
    android:viewportWidth="240"
    android:viewportHeight="150">

    <!-- The warning banner, drawn like bg_banner_warn. -->
    <path
        android:fillColor="@color/levix_warn_soft"
        android:pathData="M36,26H204A16,16 0 0,1 220,42V80A16,16 0 0,1 204,96H36A16,16 0 0,1 20,80V42A16,16 0 0,1 36,26Z"
        android:strokeColor="@color/levix_warn"
        android:strokeWidth="2" />

    <!-- Battery Guard's shield, scaled from ic_card_battery. -->
    <group
        android:scaleX="1.6"
        android:scaleY="1.6"
        android:translateX="29.6"
        android:translateY="36.8">
        <path
            android:pathData="M12,2L4,5V11C4,16.52 7.41,21.62 12,22.88C16.59,21.62 20,16.52 20,11V5L12,2Z"
            android:strokeColor="@color/levix_warn"
            android:strokeLineJoin="round"
            android:strokeWidth="1.8" />
        <path
            android:fillColor="@color/levix_warn"
            android:pathData="M12.5,6L8,12.5H12L11.5,18L16,11.5H12Z" />
    </group>

    <!-- The banner's two hint lines. -->
    <path
        android:fillAlpha="0.55"
        android:fillColor="@color/levix_text_muted"
        android:pathData="M88,48H196A4,4 0 0,1 200,52V52A4,4 0 0,1 196,56H88A4,4 0 0,1 84,52V52A4,4 0 0,1 88,48Z" />
    <path
        android:fillAlpha="0.55"
        android:fillColor="@color/levix_text_muted"
        android:pathData="M88,64H164A4,4 0 0,1 168,68V68A4,4 0 0,1 164,72H88A4,4 0 0,1 84,68V68A4,4 0 0,1 88,64Z" />

    <!-- Enable Battery Guard, the filled action. It is drawn in the brand blue
         rather than the warn colour: MaterialButton tints this button with the
         theme primary, so a blue pill is what the operator really sees. -->
    <path
        android:fillColor="@color/levix_primary"
        android:pathData="M34,106H206A14,14 0 0,1 220,120V120A14,14 0 0,1 206,134H34A14,14 0 0,1 20,120V120A14,14 0 0,1 34,106Z" />
    <path
        android:fillAlpha="0.9"
        android:fillColor="@color/levix_bg"
        android:pathData="M96,115H144A5,5 0 0,1 149,120V120A5,5 0 0,1 144,125H96A5,5 0 0,1 91,120V120A5,5 0 0,1 96,115Z" />
</vector>
