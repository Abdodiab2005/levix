<?xml version="1.0" encoding="utf-8"?>
<!-- Guide art, step 1: the home screen's primary circle, drawn in the app's
     own colours and shape so the step points at what is really on screen. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="125dp"
    android:viewportWidth="240"
    android:viewportHeight="150">

    <!-- The hero card the circle sits in. -->
    <path
        android:fillColor="@color/levix_panel"
        android:pathData="M26,6H214A18,18 0 0,1 232,24V126A18,18 0 0,1 214,144H26A18,18 0 0,1 8,126V24A18,18 0 0,1 26,6Z"
        android:strokeColor="@color/levix_border"
        android:strokeWidth="2" />

    <!-- Tap ripple around the button. -->
    <path
        android:pathData="M64,66A56,56 0 1,0 176,66A56,56 0 1,0 64,66Z"
        android:strokeAlpha="0.35"
        android:strokeColor="@color/levix_cyan"
        android:strokeWidth="2" />

    <!-- The button itself: same gradient as bg_btn_start_circle. -->
    <path
        android:pathData="M76,66A44,44 0 1,0 164,66A44,44 0 1,0 76,66Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="164"
                android:endY="22"
                android:startX="76"
                android:startY="110"
                android:type="linear">
                <item android:color="@color/levix_blue" android:offset="0.0" />
                <item android:color="@color/levix_blue_mid" android:offset="0.55" />
                <item android:color="@color/levix_cyan" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Play glyph, rounded like the real one. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M108,52L108,80L132,66Z"
        android:strokeColor="#FFFFFF"
        android:strokeLineJoin="round"
        android:strokeWidth="8" />
</vector>
