<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/levix_ripple_on_solid">
    <item>
        <selector>
            <item android:state_enabled="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/levix_primary_deep" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/btn_disabled_bg" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
