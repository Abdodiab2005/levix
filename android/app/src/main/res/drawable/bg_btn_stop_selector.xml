<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#35FF6B78">
    <item>
        <selector>
            <item android:state_enabled="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/btn_stop_active_bg" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/btn_stop_active_border" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/btn_disabled_bg" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/btn_disabled_border" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
