<?xml version="1.0" encoding="utf-8"?>
<!-- The primary action while the assistant is stopped: one large circle that
     carries the brand gradient, exactly like the old full-width button did. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/levix_ripple_on_solid">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="45"
                android:centerColor="@color/levix_primary"
                android:endColor="@color/levix_primary_deep"
                android:startColor="@color/levix_blue"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="@color/levix_primary_bright" />
        </shape>
    </item>
</ripple>
