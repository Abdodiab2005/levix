<?xml version="1.0" encoding="utf-8"?>
<!-- The circle once the assistant runs: no longer an action to press, so it
     drops the gradient and becomes a ring that reports the live state. The
     ring colour is picked per state; this is the running / starting one. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/levix_panel_raised" />
    <stroke
        android:width="3dp"
        android:color="@color/levix_cyan" />
</shape>
