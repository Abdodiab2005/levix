<?xml version="1.0" encoding="utf-8"?>
<!-- The first-run guide. One step at a time: a picture of the real screen it
     is describing, the step, then what to do there. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <!-- The wrapper exists to centre the card on a tall screen: the ScrollView
         stretches it to the viewport, and gravity does the rest. Removing it
         would let the card stretch with the viewport instead. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_raised"
            android:orientation="vertical"
            android:padding="24dp"
            tools:ignore="UselessParent">

            <TextView
                android:id="@+id/guideProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="?attr/fontFamily"
                android:textColor="@color/levix_cyan"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/guideDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:importantForAccessibility="no"
                android:orientation="horizontal" />

            <ImageView
                android:id="@+id/guideArt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:maxHeight="160dp"
                android:scaleType="fitCenter"
                android:src="@drawable/guide_step_start" />

            <TextView
                android:id="@+id/guideTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="@color/levix_text"
                android:textSize="@dimen/guide_title_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/guideBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.2"
                android:minHeight="96dp"
                android:textColor="@color/levix_text_muted"
                android:textSize="@dimen/guide_body_size" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/guideSkip"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/guide_skip" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/guideBack"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/guide_back"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/guideNext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/guide_next" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
