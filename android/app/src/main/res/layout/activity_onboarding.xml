<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/levix_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_raised"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/guideProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/levix_cyan"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/guideTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/levix_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/guideBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="110dp"
            android:lineSpacingMultiplier="1.2"
            android:textColor="@color/levix_text_muted"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/guideSkip"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/guide_skip" />

            <Button
                android:id="@+id/guideNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/guide_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
