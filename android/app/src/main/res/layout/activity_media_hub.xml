<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mediaRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/mediaBack"
            style="@style/Widget.Levix.MediaIconButton"
            android:src="@drawable/ic_media_back"
            android:contentDescription="@string/media_back" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/media_hub_title"
            android:textColor="@color/levix_text"
            android:textSize="20sp"
            android:textStyle="bold" />
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/mediaSort"
            style="@style/Widget.Levix.MediaIconButton"
            android:src="@drawable/ic_media_sort"
            android:contentDescription="@string/media_sort" />
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/mediaInsights"
            style="@style/Widget.Levix.MediaIconButton"
            android:src="@drawable/ic_media_insights"
            android:contentDescription="@string/media_insights" />
    </LinearLayout>

    <!-- Statuses | All media. One choice, kept between visits: the hub opened
         on statuses only, and everything WhatsApp stores needed three taps. -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/mediaScope"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card_panel"
        android:contentDescription="@string/media_scope"
        android:minHeight="48dp"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/levix_cyan"
        app:tabMode="fixed"
        app:tabRippleColor="@color/levix_cyan_soft"
        app:tabSelectedTextColor="@color/levix_text"
        app:tabTextColor="@color/levix_text_muted" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/mediaSearch"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_raised"
            android:hint="@string/media_search"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/levix_text"
            android:textColorHint="@color/levix_text_muted" />
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/mediaSource"
            style="@style/Widget.Levix.MediaIconButton"
            android:src="@drawable/ic_media_source"
            android:contentDescription="@string/media_source" />
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/mediaKind"
            style="@style/Widget.Levix.MediaIconButton"
            android:src="@drawable/ic_card_media"
            android:contentDescription="@string/media_category" />
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/mediaFilter"
            style="@style/Widget.Levix.MediaIconButton"
            android:src="@drawable/ic_media_filter"
            android:contentDescription="@string/media_filter" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mediaBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card_panel"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/mediaBannerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/levix_text"
            android:textSize="14sp" />
        <LinearLayout
            style="?android:attr/buttonBarStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/mediaBannerAction"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/media_allow" />
            <Button
                android:id="@+id/mediaBannerOther"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:text="@string/media_settings"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/mediaCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:textColor="@color/levix_text_muted"
        android:textSize="13sp" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mediaList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

    <LinearLayout
        android:id="@+id/mediaSelection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_raised"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/mediaSelectionCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:textColor="@color/levix_text"
            android:textSize="14sp" />
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/mediaSave"
            style="@style/Widget.Levix.MediaIconButton"
            android:src="@drawable/ic_save"
            android:contentDescription="@string/media_save" />
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/mediaShare"
            style="@style/Widget.Levix.MediaIconButton"
            android:src="@drawable/ic_share"
            android:contentDescription="@string/media_share" />
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/mediaDelete"
            style="@style/Widget.Levix.MediaIconButton"
            android:src="@drawable/ic_media_delete"
            android:contentDescription="@string/media_delete" />
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/mediaMore"
            style="@style/Widget.Levix.MediaIconButton"
            android:src="@drawable/ic_media_more"
            android:contentDescription="@string/media_more" />
    </LinearLayout>
</LinearLayout>
