<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mediaRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/levix_space_screen_h"
    android:paddingEnd="@dimen/levix_space_screen_h">

    <LinearLayout
        style="@style/Widget.Levix.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/mediaBack"
            style="@style/Widget.Levix.IconButton.Glyph.Back"
            android:contentDescription="@string/media_back"
            android:text="@string/media_back_glyph"
            android:tooltipText="@string/media_back" />

        <TextView
            style="@style/Widget.Levix.Text.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/media_hub_title" />

        <ImageView
            android:id="@+id/mediaFilter"
            style="@style/Widget.Levix.IconButton"
            android:contentDescription="@string/media_filter"
            android:src="@drawable/ic_filter"
            android:tooltipText="@string/media_filter"
            app:tint="@color/levix_text_muted" />

        <TextView
            android:id="@+id/mediaInsights"
            style="@style/Widget.Levix.IconButton.Glyph.Action"
            android:contentDescription="@string/media_insights"
            android:text="@string/media_insights_glyph"
            android:tooltipText="@string/media_insights" />

        <TextView
            android:id="@+id/mediaSort"
            style="@style/Widget.Levix.IconButton.Glyph.Action"
            android:contentDescription="@string/media_sort"
            android:text="@string/media_sort_glyph"
            android:tooltipText="@string/media_sort" />
    </LinearLayout>

    <EditText
        android:id="@+id/mediaSearch"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_card_raised"
        android:hint="@string/media_search"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/levix_text"
        android:textColorHint="@color/levix_text_muted" />

    <HorizontalScrollView
        android:id="@+id/mediaSourcesScroll"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/mediaSources"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/mediaCategories"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/mediaBanner"
        style="@style/Widget.Levix.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/mediaBannerText"
            style="@style/Widget.Levix.Text.Banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <LinearLayout
            style="?android:attr/buttonBarStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/mediaBannerAction"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/media_allow" />
            <Button
                android:id="@+id/mediaBannerOther"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:text="@string/media_settings"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/mediaCount"
        style="@style/Widget.Levix.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingBottom="8dp" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mediaList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

    <LinearLayout
        android:id="@+id/mediaSelection"
        style="@style/Widget.Levix.Card.Row.Raised"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:visibility="gone">
        <TextView
            android:id="@+id/mediaSelectionCount"
            style="@style/Widget.Levix.Text.SelectionCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1" />
        <Button
            android:id="@+id/mediaSave"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/media_save" />
        <Button
            android:id="@+id/mediaShare"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/media_share" />
        <Button
            android:id="@+id/mediaDelete"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/media_delete" />
        <TextView
            android:id="@+id/mediaMore"
            style="@style/Widget.Levix.IconButton.Glyph.More"
            android:contentDescription="@string/media_more"
            android:text="@string/media_more_glyph"
            android:tooltipText="@string/media_more" />
    </LinearLayout>
</LinearLayout>
