<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/levix_bg"
    android:fillViewport="true">

    <LinearLayout
        style="@style/Widget.Levix.Screen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Top Brand Bar -->
        <LinearLayout
            style="@style/Widget.Levix.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_levix_mark" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    style="@style/Widget.Levix.Text.Title.Brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="@string/app_name" />

                <TextView
                    style="@style/Widget.Levix.Text.Tagline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brand_tagline" />
            </LinearLayout>

            <!-- Language Switch Button (Icon Only) -->
            <ImageView
                android:id="@+id/btnLanguage"
                style="@style/Widget.Levix.IconButton.Pill"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/dialog_choose_language"
                android:src="@drawable/ic_globe"
                android:tooltipText="@string/dialog_choose_language" />

            <!-- Live Status Pill. The dot swaps its drawable from Kotlin, so
                 the two views stay separate; lint's merge hint does not apply. -->
            <LinearLayout
                android:id="@+id/statusPill"
                style="@style/Widget.Levix.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:id="@+id/statusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:contentDescription="Status indicator"
                    android:src="@drawable/ic_dot_red" />

                <TextView
                    android:id="@+id/statusPillText"
                    style="@style/Widget.Levix.Text.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/status_stopped" />
            </LinearLayout>
        </LinearLayout>

        <!-- Hero Overview Card (Centered Text Layout) -->
        <LinearLayout
            style="@style/Widget.Levix.Card.Hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/levix_gap_xl">

            <TextView
                style="@style/Widget.Levix.Text.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/hero_eyebrow" />

            <TextView
                style="@style/Widget.Levix.Text.Title.Hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/hero_title" />

            <TextView
                android:id="@+id/heroSubtitleText"
                style="@style/Widget.Levix.Text.Subtitle.Hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/hero_subtitle_stopped" />

            <!-- Primary Action: Open Control Panel -->
            <Button
                android:id="@+id/panelButton"
                style="@style/Widget.Levix.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:drawableEnd="@drawable/ic_open_panel"
                android:enabled="false"
                android:text="@string/btn_open_panel" />

            <!-- Assistant Actions: Start / Stop -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/startButton"
                    style="@style/Widget.Levix.Button.Assist.Start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_play"
                    android:text="@string/btn_start_host" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/stopButton"
                    style="@style/Widget.Levix.Button.Assist.Stop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_stop"
                    android:enabled="false"
                    android:text="@string/btn_stop_host" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusHint"
                style="@style/Widget.Levix.Text.Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Dedicated Language Switcher Card on Main Interface -->
        <LinearLayout
            android:id="@+id/cardLanguageSwitch"
            style="@style/Widget.Levix.Card.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="@dimen/levix_icon_md"
                android:layout_height="@dimen/levix_icon_md"
                android:contentDescription="Language"
                android:src="@drawable/ic_globe" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Levix.Text.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pref_language_title" />

                <TextView
                    style="@style/Widget.Levix.Text.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/pref_language_sub" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnLanguageToggleCard"
                style="@style/Widget.Levix.Pill.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pref_language_btn" />
        </LinearLayout>

        <!-- Section: Status Overview Header (Logical Start-aligned) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.Levix.Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_overview" />

            <TextView
                style="@style/Widget.Levix.Text.Section.Sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_overview_sub" />
        </LinearLayout>

        <!-- Redesigned 2-Column Tile Grid: WhatsApp & Bot Engine -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- Tile 1: WhatsApp -->
            <LinearLayout
                android:id="@+id/cardWhatsApp"
                style="@style/Widget.Levix.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="@string/action_show_whatsapp_status"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    style="@style/Widget.Levix.Toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="@dimen/levix_icon_sm"
                        android:layout_height="@dimen/levix_icon_sm"
                        android:contentDescription="WhatsApp"
                        android:src="@drawable/ic_card_whatsapp" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/whatsAppBadge"
                        style="@style/Widget.Levix.Text.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_offline" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="@dimen/levix_gap_xs"
                        android:src="@drawable/ic_chevron_right"
                        android:importantForAccessibility="no"
                        app:tint="@color/levix_text_muted" />
                </LinearLayout>

                <TextView
                    style="@style/Widget.Levix.Text.CardTitle.Large"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/card_whatsapp_title" />

                <TextView
                    android:id="@+id/whatsAppDetailText"
                    style="@style/Widget.Levix.Text.Detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="@string/card_whatsapp_desc_offline" />
            </LinearLayout>

            <!-- Tile 2: Bot Engine -->
            <LinearLayout
                android:id="@+id/cardEngine"
                style="@style/Widget.Levix.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1">

                <LinearLayout
                    style="@style/Widget.Levix.Toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="@dimen/levix_icon_sm"
                        android:layout_height="@dimen/levix_icon_sm"
                        android:contentDescription="Engine"
                        android:src="@drawable/ic_card_engine" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/engineBadge"
                        style="@style/Widget.Levix.Text.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_stopped" />
                </LinearLayout>

                <TextView
                    style="@style/Widget.Levix.Text.CardTitle.Large"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/card_engine_title" />

                <TextView
                    android:id="@+id/engineDetailText"
                    style="@style/Widget.Levix.Text.Detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/card_engine_desc_stopped" />
            </LinearLayout>
        </LinearLayout>

        <!-- Redesigned Compact Card: Media Hub -->
        <LinearLayout
            android:id="@+id/cardMediaHub"
            style="@style/Widget.Levix.Card.Compact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="@dimen/levix_icon_lg"
                android:layout_height="@dimen/levix_icon_lg"
                android:contentDescription="@string/media_hub_title"
                android:src="@drawable/ic_card_whatsapp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Levix.Text.CardTitle.Media"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/media_hub_title" />

                <TextView
                    style="@style/Widget.Levix.Text.Section.Sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/media_hub_subtitle" />
            </LinearLayout>

            <TextView
                style="@style/Widget.Levix.IconButton.Glyph.Chevron"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/media_open"
                android:text="›" />
        </LinearLayout>

        <!-- Compact Card: Battery Guard -->
        <LinearLayout
            android:id="@+id/cardBattery"
            style="@style/Widget.Levix.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout
                style="@style/Widget.Levix.Toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/batteryIcon"
                    android:layout_width="@dimen/levix_icon_sm"
                    android:layout_height="@dimen/levix_icon_sm"
                    android:contentDescription="Battery Guard"
                    android:src="@drawable/ic_card_battery" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/levix_gap_md"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.Levix.Text.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/card_battery_title" />

                    <TextView
                        android:id="@+id/batteryHint"
                        style="@style/Widget.Levix.Text.Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/battery_hint" />
                </LinearLayout>

                <TextView
                    android:id="@+id/batteryBadge"
                    style="@style/Widget.Levix.Text.Badge.Wide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CHECKING" />
            </LinearLayout>

            <Button
                android:id="@+id/batteryButton"
                style="@style/Widget.Levix.Button.Outlined.Warn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/btn_battery"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Compact Diagnostics Row: Share logs only -->
        <LinearLayout
            android:id="@+id/cardDiagnostics"
            style="@style/Widget.Levix.Card.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/levix_gap_xl">

            <ImageView
                android:layout_width="@dimen/levix_icon_sm"
                android:layout_height="@dimen/levix_icon_sm"
                android:contentDescription="Diagnostics"
                android:src="@drawable/ic_terminal" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/levix_gap_md"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Levix.Text.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_diagnostics_short" />

                <TextView
                    style="@style/Widget.Levix.Text.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/diagnostics_panel_hint" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnShareLogs"
                style="@style/Widget.Levix.IconButton.Outlined"
                android:contentDescription="@string/btn_share_logs"
                android:src="@drawable/ic_share"
                android:tooltipText="@string/btn_share_logs"
                app:tint="@color/levix_cyan" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
