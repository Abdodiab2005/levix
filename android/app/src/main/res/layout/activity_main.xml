<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/levix_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="40dp">

        <!-- Fixed brand/preferences positions in both languages; content below remains RTL. -->
        <LinearLayout
            android:id="@+id/mainHeader"
            android:layoutDirection="ltr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_levix_mark" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:gravity="left"
                    android:textDirection="locale"
                    android:text="@string/app_name"
                    android:textColor="@color/levix_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:gravity="left"
                    android:textDirection="locale"
                    android:text="@string/brand_tagline"
                    android:textColor="@color/levix_text_muted"
                    android:textSize="@dimen/home_caption" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/headerLanguageControl"
                style="@style/Widget.Levix.HeaderIconButton"
                android:contentDescription="@string/action_switch_language"
                android:src="@drawable/ic_globe" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/headerThemeControl"
                style="@style/Widget.Levix.HeaderIconButton"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/action_switch_theme"
                android:src="@drawable/ic_sun" />
        </LinearLayout>

        <!-- Hero Overview Card (Centered Text Layout) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_raised"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="?attr/fontFamily"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:text="@string/hero_eyebrow"
                android:textColor="@color/levix_cyan"
                android:textSize="@dimen/home_eyebrow"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:fontFamily="?attr/fontFamily"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:id="@+id/homeTitle"
                android:accessibilityLiveRegion="polite"
                android:text="@string/hero_title"
                android:textColor="@color/levix_text"
                android:textSize="@dimen/home_title"
                android:textStyle="bold" />

            <!-- Only the stopped state owns the large start interaction. -->
            <FrameLayout
                android:id="@+id/startCircleContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <LinearLayout
                    android:id="@+id/btnPrimaryAction"
                    android:layout_width="192dp"
                    android:layout_height="192dp"
                    android:background="@drawable/bg_btn_start_circle"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/primaryActionIcon"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_power" />

                    <TextView
                        android:id="@+id/primaryActionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="12dp"
                        android:fontFamily="?attr/fontFamily"
                        android:gravity="center"
                        android:text="@string/btn_start_host"
                        android:textColor="@color/levix_on_gradient"
                        android:textSize="@dimen/home_action"
                        android:textStyle="bold" />
                </LinearLayout>

            </FrameLayout>

            <ProgressBar
                android:id="@+id/homeProgress"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:indeterminateTint="@color/levix_cyan"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <TextView
                android:id="@+id/activationSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/levix_cyan"
                android:textSize="@dimen/home_body" />

            <TextView
                android:id="@+id/heroSubtitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/hero_subtitle_stopped"
                android:textColor="@color/levix_text_muted"
                android:textSize="@dimen/home_body" />

            <!-- Secondary Action: the control panel. -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/panelButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_home_primary"
                app:backgroundTint="@null"
                android:drawableStart="@drawable/ic_open_panel"
                android:drawablePadding="8dp"
                android:enabled="false"
                android:fontFamily="?attr/fontFamily"
                android:gravity="center"
                android:minHeight="48dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/btn_open_panel"
                android:textAllCaps="false"
                android:textColor="@color/home_primary_text"
                android:textSize="@dimen/home_body"
                app:drawableTint="@color/home_primary_text" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnStopCorner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:background="?attr/selectableItemBackground"
                android:text="@string/btn_stop_host"
                android:textAllCaps="false"
                android:textColor="@color/levix_danger"
                android:visibility="gone" />

            <TextView
                android:id="@+id/statusHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/levix_warn"
                android:textSize="@dimen/home_caption"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Battery Guard. Sits directly under the header because a restricted
             battery is the one thing that silently kills a 24/7 assistant. -->
        <LinearLayout
            android:id="@+id/cardBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/batteryIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_card_battery" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="?attr/fontFamily"
                        android:text="@string/card_battery_title"
                        android:textColor="@color/levix_text"
                        android:textSize="@dimen/home_card_title"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/batteryHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:text="@string/battery_hint"
                        android:textColor="@color/levix_text_muted"
                        android:textSize="@dimen/home_caption" />
                </LinearLayout>

                <TextView
                    android:id="@+id/batteryBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_subtle"
                    android:fontFamily="?attr/fontFamily"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:singleLine="true"
                    android:text="@string/status_checking"
                    android:textColor="@color/levix_warn"
                    android:textSize="@dimen/home_badge"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/batteryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_warn_solid"
                app:backgroundTint="@null"
                android:drawableStart="@drawable/ic_card_battery"
                android:drawablePadding="8dp"
                android:fontFamily="?attr/fontFamily"
                android:gravity="center"
                android:minHeight="48dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/btn_battery"
                android:textAllCaps="false"
                android:textColor="@color/levix_bg"
                android:textSize="@dimen/home_body"
                android:textStyle="bold"
                android:visibility="gone"
                app:drawableTint="@color/levix_bg" />
        </LinearLayout>

        <!-- Section: Status Overview Header (Logical Start-aligned) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="?attr/fontFamily"
                android:text="@string/section_overview"
                android:textColor="@color/levix_text"
                android:textSize="@dimen/home_section_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_overview_sub"
                android:textColor="@color/levix_text_muted"
                android:textSize="@dimen/home_caption" />
        </LinearLayout>

        <!-- Compact status cards: each icon shares the title row. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <!-- Tile 1: WhatsApp -->
            <LinearLayout
                android:id="@+id/cardWhatsApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_panel"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/action_show_whatsapp_status"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_card_whatsapp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:fontFamily="?attr/fontFamily"
                        android:singleLine="false"
                        android:text="@string/card_whatsapp_title"
                        android:textColor="@color/levix_text"
                        android:textSize="@dimen/home_card_title"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/whatsAppBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_subtle"
                        android:fontFamily="?attr/fontFamily"
                        android:paddingStart="6dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="2dp"
                        android:singleLine="true"
                        android:maxWidth="104dp"
                        android:ellipsize="end"
                        android:text="@string/status_offline"
                        android:textColor="@color/levix_text_muted"
                        android:textSize="@dimen/home_badge"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_chevron_right"
                        android:importantForAccessibility="no"
                        app:tint="@color/levix_text_muted" />
                </LinearLayout>

                <TextView
                    android:id="@+id/whatsAppDetailText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="1.15"
                    android:maxLines="4"
                    android:singleLine="false"
                    android:text="@string/card_whatsapp_desc_offline"
                    android:textColor="@color/levix_text_muted"
                    android:textSize="@dimen/home_caption" />
            </LinearLayout>

            <!-- Tile 2: Bot Engine -->
            <LinearLayout
                android:id="@+id/cardEngine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_panel"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_card_engine" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:fontFamily="?attr/fontFamily"
                        android:singleLine="false"
                        android:text="@string/card_engine_title"
                        android:textColor="@color/levix_text"
                        android:textSize="@dimen/home_card_title"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/engineBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_subtle"
                        android:fontFamily="?attr/fontFamily"
                        android:paddingStart="6dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="2dp"
                        android:singleLine="true"
                        android:maxWidth="104dp"
                        android:ellipsize="end"
                        android:text="@string/status_stopped"
                        android:textColor="@color/levix_text_muted"
                        android:textSize="@dimen/home_badge"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/engineDetailText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="1.15"
                    android:maxLines="2"
                    android:text="@string/card_engine_desc_stopped"
                    android:textColor="@color/levix_text_muted"
                    android:textSize="@dimen/home_caption" />
            </LinearLayout>
        </LinearLayout>

        <!-- Media Hub -->
        <LinearLayout
            android:id="@+id/cardMediaHub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_panel"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="72dp"
            android:orientation="horizontal"
            android:padding="16dp">
            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_card_media" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/media_hub_title"
                    android:textColor="@color/levix_text"
                    android:textSize="@dimen/home_section_title"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/media_hub_subtitle"
                    android:textColor="@color/levix_text_muted"
                    android:textSize="@dimen/home_caption" />
            </LinearLayout>
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/levix_text_muted" />
        </LinearLayout>

        <!-- Diagnostics: the whole card opens the actions sheet. -->
        <LinearLayout
            android:id="@+id/cardDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_panel"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_terminal" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="?attr/fontFamily"
                    android:text="@string/section_diagnostics_short"
                    android:textColor="@color/levix_text"
                    android:textSize="@dimen/home_card_title"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/diagnostics_panel_hint"
                    android:textColor="@color/levix_text_muted"
                    android:textSize="@dimen/home_eyebrow" />
            </LinearLayout>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/levix_text_muted" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/cardShowGuide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_panel"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_levix_mark" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/guide_again_title"
                    android:textColor="@color/levix_text"
                    android:textSize="@dimen/home_action"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/guide_again_sub"
                    android:textColor="@color/levix_text_muted"
                    android:textSize="@dimen/home_eyebrow" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
