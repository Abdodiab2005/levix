<?xml version="1.0" encoding="utf-8"?>
<!-- One coach-mark card: what this stop is, and the only three things a
     reader can do with it. Positioned by CoachMarkOverlay above or below the
     hole, so its own margins are layout neutrality only. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/levix_panel"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:rippleColor="@color/levix_ripple"
    app:strokeColor="@color/levix_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/coachStepLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="?attr/fontFamily"
            android:textColor="@color/levix_cyan"
            android:textSize="@dimen/home_eyebrow"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/coachTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:accessibilityHeading="true"
            android:fontFamily="?attr/fontFamily"
            android:textColor="@color/levix_text"
            android:textSize="@dimen/sheet_title_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/coachBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.25"
            android:textColor="@color/levix_text_muted"
            android:textSize="@dimen/sheet_body_size" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/coachSkip"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:text="@string/guide_skip" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/coachBack"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:text="@string/guide_back"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/coachNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:text="@string/guide_next" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
