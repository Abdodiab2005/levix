{
  "name": "levix-bot",
  "version": "2.0.0",
  "description": "A self-hosted personal WhatsApp bot with an AI agent, group moderation and a web control panel.",
  "main": "src/index.js",
  "scripts": {
    "start": "node bin/levix.js",
    "dev": "nodemon bin/levix.js",
    "test": "node tests/run.mjs",
    "brand:assets": "node scripts/build-brand-assets.mjs",
    "build:sea": "node scripts/build-sea.mjs",
    "validate:tarball": "node scripts/validate-tarball.mjs",
    "validate:sea": "node scripts/validate-sea.mjs",
    "validate:docker": "bash scripts/validate-docker.sh"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "gemini",
    "ai-agent",
    "sqlite",
    "self-hosted"
  ],
  "author": "Abdelrhman Diab (Leviro)",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "axios": "^1.9.0",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "node-cache": "^5.1.2",
    "node-cron": "^4.1.0",
    "node-gtts": "^2.0.2",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Abdodiab2005/levix.git"
  },
  "homepage": "https://github.com/Abdodiab2005/levix",
  "bugs": {
    "url": "https://github.com/Abdodiab2005/levix/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "sharp": "^0.35.3"
  },
  "bin": {
    "levix": "bin/levix.js"
  },
  "files": [
    "bin/",
    "src/",
    "views/",
    "public/",
    "deploy/",
    "app.cjs",
    "scheduler.cjs",
    "README.md",
    "SETUP.md",
    "LICENSE"
  ]
}
