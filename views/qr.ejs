<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= brand.name %> · Link WhatsApp</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/icon-32.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="stylesheet" href="/dashboard.css" />
  </head>
  <body class="gateway-page">
    <main class="gateway-shell">
      <section class="gateway-story" aria-label="About <%= brand.name %>">
        <div class="brand-lockup" aria-label="<%= brand.name %>">
          <img src="/brand/mark.svg" alt="" />
          <span><strong><%= brand.name %></strong><small><%= brand.tagline %></small></span>
        </div>

        <div class="gateway-copy">
          <span class="eyebrow">A direct line</span>
          <h2>Bring your assistant online.</h2>
          <p>One scan securely links Levix to the WhatsApp account you choose.</p>
        </div>

        <div class="gateway-mark" aria-hidden="true">
          <span class="gateway-ring"></span>
          <img src="/brand/mark.svg" alt="" />
        </div>

        <p class="gateway-trust"><span></span> Live pairing status</p>
      </section>

      <section class="gateway-panel">
        <div class="gateway-panel-inner qr-panel-inner">
          <div class="card auth-card qr-card">
            <div class="card-head qr-card-head">
              <div>
                <span class="eyebrow">Link device</span>
                <h1>Scan with WhatsApp</h1>
              </div>
              <span class="pill" id="state"><span class="dot"></span>Waiting…</span>
            </div>

            <div class="qr-box">
              <div class="qr-frame" id="frame"></div>
              <ol class="steps">
                <li><span>Open</span> WhatsApp on the phone the bot should use.</li>
                <li><span>Choose</span> Settings → Linked devices → Link a device.</li>
                <li><span>Scan</span> the code shown above.</li>
              </ol>
              <div class="callout compact-callout">
                <span class="callout-icon" aria-hidden="true">i</span>
                <p>No code yet? Press <strong>Start session</strong> on the dashboard's Connection screen.</p>
              </div>
            </div>

            <a class="btn qr-back" href="/">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
              Back to dashboard
            </a>
          </div>

          <div class="foot"><%= brand.name %> by <%= brand.developer %> · <%= brand.studio %></div>
        </div>
      </section>
    </main>

    <script src="/socket.io.min.js"></script>
    <script src="/qrcode.min.js"></script>
    <script>
      (() => {
        const frame = document.getElementById("frame");
        const state = document.getElementById("state");
        let painted = null;

        function setState(text, kind) {
          state.className = `pill ${kind || ""}`;
          state.innerHTML = `<span class="dot"></span>${text}`;
        }

        function render(qr) {
          if (!qr || painted === qr) return;
          painted = qr;
          frame.innerHTML = "";
          new QRCode(frame, {
            text: qr,
            width: 250,
            height: 250,
            correctLevel: QRCode.CorrectLevel.H,
          });
          setState("Scan me", "");
        }

        // The QR the server already had when this page was rendered.
        const initial = <%- JSON.stringify(qr || "") %>;
        if (initial) render(initial);
        else setState("Waiting for a code…", "");

        function clear(text, kind) {
          painted = null;
          frame.innerHTML = "";
          setState(text, kind || "");
        }

        const socket = io();
        socket.on("qr", render);

        // The backend drops a code the moment it stops being scannable. Without
        // this the page sat on an expired QR forever, and somebody would keep
        // pointing a phone at it.
        socket.on("qr_cleared", () => clear("Waiting for a code…", ""));

        socket.on("session", (state) => {
          if (state.state === "connected") {
            frame.innerHTML = '<div class="qr-success">Linked ✓</div>';
            painted = null;
            setState("Connected", "on");
            return;
          }
          if (state.state === "waiting_for_qr") return; // the qr event paints it
          clear(state.canStart ? "Not started — start it from the dashboard" : "Connecting…", "");
        });
      })();
    </script>
  </body>
</html>
