<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= brand.name %> · Control panel</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/icon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/brand/icon-16.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="stylesheet" href="/dashboard.css" />
  </head>
  <body class="dashboard-page">
    <div class="shell">
      <aside class="sidebar" id="sidebar">
        <a
          class="brand"
          href="#overview"
          aria-label="<%= brand.name %> overview"
        >
          <img src="/brand/mark.svg" alt="" />
          <div class="brand-copy">
            <div class="brand-name"><%= brand.name %></div>
            <div class="brand-tag">Private control room</div>
          </div>
          <span class="brand-pulse" aria-hidden="true"
            ><i></i><i></i><i></i
          ></span>
        </a>

        <nav class="nav" aria-label="Primary navigation">
          <a href="#overview" data-view="overview">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="7" height="7" x="3" y="3" rx="1" />
              <rect width="7" height="7" x="14" y="3" rx="1" />
              <rect width="7" height="7" x="14" y="14" rx="1" />
              <rect width="7" height="7" x="3" y="14" rx="1" />
            </svg>
            <span data-i18n="overview">Overview</span>
          </a>
          <a href="#connection" data-view="connection">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4.9 19.1C1 15.2 1 8.8 4.9 4.9" />
              <path d="M7.8 16.2c-2.3-2.3-2.3-6.1 0-8.5" />
              <circle cx="12" cy="12" r="2" />
              <path d="M16.2 7.8c2.3 2.3 2.3 6.1 0 8.5" />
              <path d="M19.1 4.9C23 8.8 23 15.1 19.1 19" />
            </svg>
            <span data-i18n="connection">Connection</span>
          </a>

          <div class="nav-label" data-i18n="control">Control</div>
          <a href="#commands" data-view="commands">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="4 17 10 11 4 5" />
              <line x1="12" y1="19" x2="20" y2="19" />
            </svg>
            <span data-i18n="commands">Commands</span>
          </a>
          <a href="#ai" data-view="ai">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 8V4H8" />
              <rect width="16" height="12" x="4" y="8" rx="2" />
              <path d="M2 14h2" />
              <path d="M20 14h2" />
              <path d="M15 13v2" />
              <path d="M9 13v2" />
            </svg>
            <span data-i18n="ai">AI &amp; memory</span>
          </a>
          <a href="#groups" data-view="groups">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
              <circle cx="9" cy="7" r="4" />
              <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
              <path d="M16 3.13a4 4 0 0 1 0 7.75" />
            </svg>
            <span data-i18n="groups">Groups</span>
          </a>
          <a href="#roles" data-view="roles">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
            </svg>
            <span data-i18n="roles">Roles</span>
          </a>

          <div class="nav-label" data-i18n="data_label">Data</div>
          <a href="#data" data-view="data">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
            </svg>
            <span data-i18n="data">Tables</span>
          </a>
          <a href="#settings" data-view="settings">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="4" x2="4" y1="21" y2="14" />
              <line x1="4" x2="4" y1="10" y2="3" />
              <line x1="12" x2="12" y1="21" y2="12" />
              <line x1="12" x2="12" y1="8" y2="3" />
              <line x1="20" x2="20" y1="21" y2="16" />
              <line x1="20" x2="20" y1="12" y2="3" />
              <line x1="1" x2="7" y1="14" y2="14" />
              <line x1="9" x2="15" y1="8" y2="8" />
              <line x1="17" x2="23" y1="16" y2="16" />
            </svg>
            <span data-i18n="settings">Settings</span>
          </a>
        </nav>

        <div class="sidebar-foot">
          <div class="local-note">
            <span class="local-note-icon" aria-hidden="true"></span>
            <span
              ><strong>Self-hosted</strong>Your workspace, on your server.</span
            >
          </div>
          <div class="sidebar-credit flex">
            <div class="c1">
              &copy; <%= brand.copyrightYear %>
              <a href="<%= brand.developerSite %>"><%= brand.developer %></a>
              (<a href="<%= brand.studioSite %>"><%= brand.studio %></a>)
            </div>
            <a
              href="<%= brand.repo %>"
              target="_blank"
              rel="noopener noreferrer"
              >Source &amp; docs ↗</a
            >
          </div>
        </div>
      </aside>

      <button
        class="sidebar-backdrop"
        id="sidebar-backdrop"
        type="button"
        aria-label="Close navigation"
      ></button>

      <div class="main">
        <header class="topbar">
          <button
            class="btn btn-icon menu-btn"
            id="menu-btn"
            type="button"
            aria-label="Open navigation"
            aria-controls="sidebar"
            aria-expanded="false"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
          </button>
          <div class="page-heading">
            <span>Levix workspace</span>
            <h1 id="page-title">Overview</h1>
          </div>
          <div class="spacer"></div>
          <div class="topbar-actions">
            <span class="pill" id="status-pill"
              ><span class="dot"></span>Checking…</span
            >
            <div class="icon-cluster">
              <button
                class="btn btn-icon"
                id="refresh-btn"
                type="button"
                aria-label="Refresh current view"
                title="Refresh current view"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M20 11a8 8 0 1 0-2.34 5.66M20 4v7h-7" />
                </svg>
              </button>
              <button
                class="btn btn-icon theme-toggle"
                id="theme-btn"
                type="button"
                aria-label="Switch color theme"
                title="Switch color theme"
              >
                <svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="3.5" />
                  <path
                    d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"
                  />
                </svg>
                <svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M20 15.4A8.5 8.5 0 0 1 8.6 4a8.5 8.5 0 1 0 11.4 11.4z"
                  />
                </svg>
              </button>
              <button
                class="btn btn-icon lang-btn"
                id="lang-btn"
                type="button"
                aria-label="Switch language"
                title="Switch language / تغيير اللغة"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <circle cx="12" cy="12" r="10" />
                  <line x1="2" y1="12" x2="22" y2="12" />
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                </svg>
                <span class="lang-tag" id="lang-tag">AR</span>
              </button>
            </div>
            <form action="/logout" method="post" class="logout-form">
              <button type="submit" class="btn btn-sm logout-btn">
                <span>Log out</span>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M10 17l5-5-5-5M15 12H3M14 3h5a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-5"
                  />
                </svg>
              </button>
            </form>
          </div>
        </header>

        <main class="content">
          <!-- Overview ---------------------------------------------------->
          <section class="view" id="view-overview">
            <div class="overview-hero">
              <div class="hero-copy">
                <span class="eyebrow">Personal assistant operations</span>
                <h2>Your conversations,<br /><em>under one calm roof.</em></h2>
                <p>
                  Watch the live connection, shape how Levix responds, and
                  manage the details that keep every chat moving.
                </p>
                <div class="hero-actions">
                  <a class="btn btn-primary" href="#connection">
                    Manage connection
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M5 12h14M13 6l6 6-6 6" />
                    </svg>
                  </a>
                  <a class="text-link" href="#settings"
                    >Tune workspace <span aria-hidden="true">↗</span></a
                  >
                </div>
              </div>
              <div class="signal-stage" aria-hidden="true">
                <div class="signal-orbit orbit-one"></div>
                <div class="signal-orbit orbit-two"></div>
                <div class="signal-core">
                  <img src="/brand/mark.svg" alt="" />
                </div>
                <span class="signal-node node-one"></span>
                <span class="signal-node node-two"></span>
                <span class="signal-node node-three"></span>
                <div class="signal-label">
                  <span>Always within reach</span
                  ><strong>One private workspace</strong>
                </div>
              </div>
            </div>

            <div class="section-head section-head-split">
              <div>
                <span class="eyebrow">Workspace pulse</span>
                <h2>At a glance</h2>
                <p>The essentials from your running assistant.</p>
              </div>
              <span class="section-note">Refreshes every 15 seconds</span>
            </div>

            <div class="stats" id="stat-cards"></div>

            <div class="card runtime-card">
              <div class="card-head">
                <div>
                  <span class="eyebrow">Runtime</span>
                  <h2>System signals</h2>
                </div>
                <span class="source">Current process</span>
              </div>
              <div class="grid-2" id="overview-info"></div>
            </div>
          </section>

          <!-- Connection -------------------------------------------------->
          <section class="view" id="view-connection">
            <div class="section-head">
              <span class="eyebrow">Live link</span>
              <h2>Connection</h2>
              <p>
                Start or stop the WhatsApp session, and link or unlink an
                account.
              </p>
            </div>

            <div class="card session-card">
              <div class="card-head">
                <div>
                  <span class="eyebrow">WhatsApp</span>
                  <h2>Session</h2>
                </div>
                <div class="spacer"></div>
                <span id="conn-state"></span>
              </div>

              <div class="hint session-detail" id="conn-detail"></div>
              <div id="conn-disconnect-alert" class="session-error-callout" style="display: none; margin-top: 10px; padding: 10px 14px; border-radius: 8px; background: rgba(239, 68, 68, 0.12); color: #ef4444; font-size: 13px; font-weight: 500; border: 1px solid rgba(239, 68, 68, 0.25);">
                <span id="conn-disconnect-text"></span>
              </div>

              <div class="hint" id="conn-proxy"></div>

              <div id="pair-chooser" class="pair-chooser">
                <p class="hint">How should this phone link?</p>
                <div class="pair-methods">
                  <label class="pair-option">
                    <input type="radio" name="pair-method" value="qr" />
                    QR code
                  </label>
                  <label class="pair-option">
                    <input type="radio" name="pair-method" value="pairing" />
                    Pairing code
                  </label>
                </div>
                <div id="pair-phone-wrap" class="pair-phone-wrap" hidden>
                  <label for="pair-phone">WhatsApp number with country code</label>
                  <input
                    id="pair-phone"
                    type="tel"
                    inputmode="numeric"
                    autocomplete="tel"
                    placeholder="2010…"
                  />
                  <p class="hint">This WhatsApp’s own number. Country code, no leading 0 (Egypt: 2010… not 010…).</p>
                </div>
              </div>

              <div class="inline action-cluster">
                <button class="btn btn-primary" id="start-btn" type="button">
                  Start session
                </button>
                <button class="btn" id="reconnect-btn" type="button">
                  Reconnect to apply
                </button>
                <button class="btn" id="stop-btn" type="button">
                  Stop session
                </button>
                <button class="btn btn-danger" id="unlink-btn" type="button">
                  Unlink account
                </button>
                <button class="btn" id="restart-btn" type="button">
                  Restart bot
                </button>
              </div>
              <div class="callout">
                <span class="callout-icon" aria-hidden="true">i</span>
                <p>
                  Levix runs whether or not WhatsApp is connected. Starting the
                  session is the only thing that opens a connection; restart
                  only comes back on its own under a supervisor (pm2, systemd,
                  Docker).
                </p>
              </div>

              <div id="qr-panel" style="display: none">
                <div class="qr-box" id="qr-box">
                  <div class="qr-frame" id="qr-frame"></div>
                  <div class="hint" id="qr-note">Waiting for a QR code…</div>
                  <ol class="steps" id="qr-steps">
                    <li>Open WhatsApp on the phone the bot should use.</li>
                    <li>Settings → Linked devices → Link a device.</li>
                    <li>Point the camera at the code above.</li>
                  </ol>
                </div>
                <div class="qr-box" id="pairing-box" hidden>
                  <div class="pairing-code" id="pairing-code">••••-••••</div>
                  <div class="hint" id="pairing-phone"></div>
                  <div class="hint" id="pairing-note">Waiting for a pairing code…</div>
                  <ol class="steps">
                    <li>Open WhatsApp on that number → Settings → Linked devices.</li>
                    <li>Link a device → Link with phone number instead.</li>
                    <li>Type the code above. Get a new code if it fails.</li>
                  </ol>
                </div>
              </div>
            </div>
          </section>

          <!-- Commands ---------------------------------------------------->
          <section class="view" id="view-commands">
            <div class="section-head">
              <span class="eyebrow">Behavior</span>
              <h2>Commands</h2>
              <p>
                Rename triggers, change who may run what, switch commands off.
              </p>
            </div>

            <div class="card compact-card">
              <div class="card-head"><h2>Prefix</h2></div>
              <div class="inline prefix-control">
                <label class="sr-only" for="prefix-input">Command prefix</label>
                <input type="text" id="prefix-input" maxlength="3" />
                <button class="btn btn-primary" id="prefix-save" type="button">
                  Save prefix
                </button>
                <span class="hint"
                  >The character every command starts with, e.g.
                  <code>!ping</code>.</span
                >
              </div>
            </div>

            <div class="card">
              <div class="toolbar">
                <label class="search-field">
                  <span class="sr-only">Search commands</span>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" />
                    <path d="m20 20-4-4" />
                  </svg>
                  <input
                    type="text"
                    id="cmd-search"
                    placeholder="Search commands…"
                  />
                </label>
                <select id="cmd-filter" aria-label="Filter commands by type">
                  <option value="all">All commands</option>
                  <option value="general">General</option>
                  <option value="group">Group</option>
                </select>
                <div class="spacer" style="flex: 1"></div>
                <span class="hint">Changes apply to the next message.</span>
              </div>

              <div class="table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th>Command</th>
                      <th>Type</th>
                      <th>Aliases (comma separated)</th>
                      <th>Who can run it</th>
                      <th>On</th>
                    </tr>
                  </thead>
                  <tbody id="cmd-body">
                    <tr>
                      <td colspan="5"><div class="loading">Loading…</div></td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </section>

          <!-- AI ---------------------------------------------------------->
          <section class="view" id="view-ai">
            <div class="section-head">
              <span class="eyebrow">Intelligence</span>
              <h2>AI &amp; memory</h2>
              <p>
                The prompt the model gets, and everything it has been told to
                remember.
              </p>
            </div>

            <div class="card">
              <div class="card-head">
                <h2>System prompt</h2>
                <div class="spacer"></div>
                <span class="hint"
                  ><code id="persona-file">ai-persona.md</code></span
                >
              </div>
              <textarea id="persona-body" spellcheck="false"></textarea>
              <div class="inline form-actions">
                <button class="btn btn-primary" id="persona-save" type="button">
                  Save prompt
                </button>
                <span class="hint"
                  >Applies to the next message — no restart.</span
                >
              </div>
            </div>

            <div class="card">
              <div class="card-head"><h2>Long-term memory</h2></div>
              <div class="inline" id="memory-list"></div>

              <div
                id="memory-editor"
                class="memory-editor"
                style="display: none"
              >
                <div class="card-head">
                  <h2>Editing <code id="memory-scope"></code></h2>
                </div>
                <textarea id="memory-content" spellcheck="false"></textarea>
                <div class="inline form-actions">
                  <button
                    class="btn btn-primary"
                    id="memory-save"
                    type="button"
                  >
                    Save memory
                  </button>
                  <button
                    class="btn btn-danger"
                    id="memory-delete"
                    type="button"
                  >
                    Delete file
                  </button>
                  <span class="hint"
                    >Plain Markdown — a line starting with <code>-</code> is one
                    memory.</span
                  >
                </div>
              </div>
            </div>
          </section>

          <!-- Groups ------------------------------------------------------>
          <section class="view" id="view-groups">
            <div class="section-head">
              <span class="eyebrow">Moderation</span>
              <h2>Groups</h2>
              <p>
                Moderation settings per group. Same values the
                <code>!group</code> commands change.
              </p>
            </div>
            <div id="groups-list"><div class="loading">Loading…</div></div>
          </section>

          <!-- Roles ------------------------------------------------------->
          <section class="view" id="view-roles">
            <div class="section-head">
              <span class="eyebrow">Access</span>
              <h2>Roles</h2>
              <p>
                Bot-level roles. An owner can do everything; an admin counts as
                an admin in every chat.
              </p>
            </div>

            <div class="card">
              <div class="card-head"><h2>Add someone</h2></div>
              <div class="inline role-control">
                <label class="sr-only" for="role-number">Phone number</label>
                <input
                  type="text"
                  id="role-number"
                  placeholder="201234567890"
                  inputmode="numeric"
                />
                <label class="sr-only" for="role-kind">Role</label>
                <select id="role-kind">
                  <option value="admin">Admin</option>
                  <option value="owner">Owner</option>
                </select>
                <button class="btn btn-primary" id="role-add" type="button">
                  Add person
                </button>
                <span class="hint">International format, digits only.</span>
              </div>
            </div>

            <div class="card">
              <div class="card-head"><h2>Owners</h2></div>
              <div class="table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th>Number</th>
                      <th>Name</th>
                      <th></th>
                    </tr>
                  </thead>
                  <tbody id="owners-body"></tbody>
                </table>
              </div>
            </div>

            <div class="card">
              <div class="card-head"><h2>Admins</h2></div>
              <div class="table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th>Number</th>
                      <th>Name</th>
                      <th></th>
                    </tr>
                  </thead>
                  <tbody id="admins-body"></tbody>
                </table>
              </div>
            </div>
          </section>

          <!-- Data -------------------------------------------------------->
          <section class="view" id="view-data">
            <div class="section-head">
              <span class="eyebrow">Stored records</span>
              <h2>Tables</h2>
              <p>
                What the bot has stored: debts, warnings, notes, todo lists,
                known users.
              </p>
            </div>

            <div class="card">
              <div
                class="toolbar data-tabs"
                id="data-tabs"
                role="tablist"
                aria-label="Stored data tables"
              >
                <button
                  class="btn btn-sm btn-primary"
                  data-table="debts"
                  type="button"
                  role="tab"
                  aria-selected="true"
                >
                  Debts
                </button>
                <button
                  class="btn btn-sm"
                  data-table="warnings"
                  type="button"
                  role="tab"
                  aria-selected="false"
                >
                  Warnings
                </button>
                <button
                  class="btn btn-sm"
                  data-table="notes"
                  type="button"
                  role="tab"
                  aria-selected="false"
                >
                  Notes
                </button>
                <button
                  class="btn btn-sm"
                  data-table="todos"
                  type="button"
                  role="tab"
                  aria-selected="false"
                >
                  Todos
                </button>
                <button
                  class="btn btn-sm"
                  data-table="users"
                  type="button"
                  role="tab"
                  aria-selected="false"
                >
                  Users
                </button>
                <button
                  class="btn btn-sm"
                  data-table="schedules"
                  type="button"
                  role="tab"
                  aria-selected="false"
                >
                  Schedules
                </button>
              </div>
              <div id="data-table"><div class="loading">Loading…</div></div>
            </div>
          </section>

          <!-- Settings ---------------------------------------------------->
          <section class="view" id="view-settings">
            <div class="section-head">
              <span class="eyebrow" data-i18n="workspace">Workspace</span>
              <h2 data-i18n="settings">Settings</h2>
              <p data-i18n="settings_sub">
                This page is the only place the bot is configured — there is no
                config file. Clear a field to go back to its default.
              </p>
            </div>

            <!-- Settings Category Navigation -->
            <div class="settings-nav-tabs" role="tablist" id="settings-nav-tabs">
              <button class="settings-tab active" data-tab="ai" type="button" role="tab" aria-selected="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg>
                <span data-i18n="settings_tab_ai">AI Assistant</span>
              </button>
              <button class="settings-tab" data-tab="general" type="button" role="tab" aria-selected="false">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" x2="4" y1="21" y2="14"/><line x1="4" x2="4" y1="10" y2="3"/><line x1="12" x2="12" y1="21" y2="12"/><line x1="12" x2="12" y1="8" y2="3"/><line x1="20" x2="20" y1="21" y2="16"/><line x1="20" x2="20" y1="12" y2="3"/><line x1="1" x2="7" y1="14" y2="14"/><line x1="9" x2="15" y1="8" y2="8"/><line x1="17" x2="23" y1="16" y2="16"/></svg>
                <span data-i18n="settings_tab_general">General</span>
              </button>
              <button class="settings-tab" data-tab="security" type="button" role="tab" aria-selected="false">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
                <span data-i18n="settings_tab_security">Security</span>
              </button>
              <button class="settings-tab" data-tab="whatsapp" type="button" role="tab" aria-selected="false">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
                <span data-i18n="settings_tab_whatsapp">WhatsApp Proxy</span>
              </button>
              <button class="settings-tab" data-tab="media" type="button" role="tab" aria-selected="false">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" x2="2" y1="12" y2="12"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/><line x1="6" x2="6.01" y1="16" y2="16"/><line x1="10" x2="10.01" y1="16" y2="16"/></svg>
                <span data-i18n="settings_tab_media">Media & Storage</span>
              </button>
            </div>

            <div id="settings-tab-security" class="settings-tab-content" style="display: none;">
              <div class="card security-card">
                <div class="card-head"><h2 data-i18n="pw_heading">Control panel password</h2></div>
                <div class="password-grid">
                  <label class="field">
                    <span data-i18n="pw_current">Current password</span>
                    <input
                      type="password"
                      id="pw-current"
                      autocomplete="current-password"
                    />
                  </label>
                  <label class="field">
                    <span data-i18n="pw_next">New password</span>
                    <input
                      type="password"
                      id="pw-next"
                      autocomplete="new-password"
                    />
                  </label>
                  <button class="btn btn-primary" id="pw-save" type="button" data-i18n="pw_change_btn">
                    Change password
                  </button>
                </div>
                <div class="hint" data-i18n="pw_hint">
                  This password is the only thing between the internet and a
                  linked WhatsApp account. It is stored as a hash — nobody,
                  including this page, can read it back.
                </div>
              </div>
            </div>

            <div id="settings-list"><div class="loading">Loading…</div></div>

            <!-- Advanced AI Settings Modal -->
            <div class="modal-backdrop" id="ai-advanced-modal" style="display: none;">
              <div class="modal-card">
                <div class="modal-head">
                  <h2 data-i18n="ai_advanced_title">Advanced AI Settings</h2>
                  <button class="btn btn-icon modal-close" id="ai-advanced-close" type="button" aria-label="Close">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
                  </button>
                </div>
                <div class="modal-body" id="ai-advanced-fields"></div>
                <div class="modal-foot">
                  <button class="btn btn-primary" id="ai-advanced-done" type="button" data-i18n="done">Done</button>
                </div>
              </div>
            </div>
          </section>
        </main>
      </div>
    </div>

    <div class="toasts" id="toasts"></div>

    <script src="/socket.io.min.js"></script>
    <script src="/qrcode.min.js"></script>
    <script src="/dashboard.js"></script>
  </body>
</html>
