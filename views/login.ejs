<!DOCTYPE html>
<html data-brand="<%= brand.name %>">
  <head>
    <script src="/ui-boot.js"></script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title data-i18n="titleLogin"><%= brand.name %> · Sign in</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/icon-32.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="stylesheet" href="/dashboard.css" />
  </head>
  <body class="gateway-page">
    <main class="gateway-shell">
      <section class="gateway-story" aria-label="About <%= brand.name %>" data-i18n-aria-label="storyAbout">
        <div class="brand-lockup" aria-label="<%= brand.name %>">
          <img src="/brand/mark.svg" alt="" />
          <span><strong><%= brand.name %></strong><small data-i18n="tagline"><%= brand.tagline %></small></span>
        </div>

        <div class="gateway-copy">
          <span class="eyebrow" data-i18n="selfHosted">Self-hosted by design</span>
          <h2 data-i18n="loginHeadline">The quiet control room behind every chat.</h2>
          <p data-i18n="loginLede">Connection, commands, memory, and moderation stay together—on your server and within reach.</p>
        </div>

        <div class="gateway-mark" aria-hidden="true">
          <span class="gateway-ring"></span>
          <img src="/brand/mark.svg" alt="" />
        </div>

        <p class="gateway-trust" data-i18n-html="loginTrust"><span></span> Private workspace · direct control</p>
      </section>

      <section class="gateway-panel">
        <div class="gateway-panel-inner">
          <form class="card auth-card" id="login-card" action="/login" method="post">
            <button type="button" class="gateway-back-btn" id="login-back-app" hidden>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
              <span data-i18n="backToApp">Back to app</span>
            </button>
            <div class="auth-head">
              <span class="eyebrow" data-i18n="secureAccess">Secure access</span>
              <h1 data-i18n="welcomeBack">Welcome back</h1>
              <p class="sub" data-i18n="loginSub">Sign in to manage your Levix workspace.</p>
            </div>

            <label class="field">
              <span data-i18n="passwordLabel">Control panel password</span>
              <div class="input-wrap">
                <input
                  type="password" dir="ltr" spellcheck="false" autocapitalize="off" autocorrect="off"
                  name="password"
                  autocomplete="current-password"
                  placeholder="Enter your password"
                  data-i18n-placeholder="passwordPlaceholder"
                  autofocus
                  required
                />
                <button type="button" class="eye-btn" aria-label="Show password" data-i18n-aria-label="showPassword" aria-pressed="false">
                  <svg class="eye-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                  <svg class="eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c6.5 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3.5 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg>
                </button>
              </div>
            </label>

            <button type="submit" class="btn btn-primary auth-submit">
              <span data-i18n="openWorkspace">Open workspace</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </button>

            <% if (error) { %>
            <div class="error" role="alert" data-i18n-error="<%= errorCode %>" data-i18n-n="<%= minLength %>"><%= error %></div>
            <% } %>

            <div class="auth-alt">
              <button type="button" class="link-btn" id="forgot-link" data-i18n="forgotPassword">Forgot password?</button>
            </div>
          </form>

          <div class="card auth-card" id="reset-card" hidden>
            <button type="button" class="gateway-back-btn" id="reset-back">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
              <span data-i18n="backToSignIn">Back to sign in</span>
            </button>
            <div class="auth-head">
              <span class="eyebrow" data-i18n="resetEyebrow">Password reset</span>
              <h1 data-i18n="resetTitle">Reset your password</h1>
              <% if (recoveryEmail) { %>
              <p class="sub" data-i18n="resetSubtitleChannels">
                Levix can send a one-time code to WhatsApp, or to your recovery email. The code works for 10 minutes.
              </p>
              <% } else { %>
              <p class="sub" data-i18n="resetSubtitle">
                Levix sends a one-time code to your WhatsApp — the linked account's own chat.
                The code works for 10 minutes.
              </p>
              <% } %>
            </div>

            <div id="reset-channels" class="reset-channels">
              <button type="button" class="btn btn-primary auth-submit" id="reset-send" data-channel="whatsapp">
                <span data-i18n="resetSend">Send code to WhatsApp</span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </button>
              <% if (recoveryEmail) { %>
              <button type="button" class="btn auth-submit" id="reset-send-email" data-channel="email">
                <span data-i18n="resetSendEmail">Send code to email</span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </button>
              <p class="sub reset-email-hint">
                <span data-i18n="resetEmailHint">The code goes to</span>
                <strong dir="ltr"><%= recoveryEmail %></strong>
              </p>
              <% } %>
            </div>

            <form id="reset-form" hidden>
              <label class="field">
                <span data-i18n="resetCodeLabel">Reset code</span>
                <input
                  type="text"
                  id="reset-code"
                  inputmode="numeric"
                  autocomplete="one-time-code"
                  maxlength="6"
                  placeholder="6 digits"
                  data-i18n-placeholder="resetCodePlaceholder"
                  required
                />
              </label>

              <label class="field">
                <span data-i18n="newPassword">New password</span>
                <div class="input-wrap">
                  <input
                    type="password" dir="ltr" spellcheck="false" autocapitalize="off" autocorrect="off"
                    id="reset-pass"
                    autocomplete="new-password"
                    placeholder="At least <%= minLength %> characters"
                    data-i18n-placeholder="minLengthPlaceholder"
                    data-i18n-n="<%= minLength %>"
                    minlength="<%= minLength %>"
                    required
                  />
                  <button type="button" class="eye-btn" aria-label="Show password" data-i18n-aria-label="showPassword" aria-pressed="false">
                    <svg class="eye-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                    <svg class="eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c6.5 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3.5 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg>
                  </button>
                </div>
              </label>

              <label class="field">
                <span data-i18n="repeatPassword">Repeat password</span>
                <div class="input-wrap">
                  <input
                    type="password" dir="ltr" spellcheck="false" autocapitalize="off" autocorrect="off"
                    id="reset-confirm"
                    autocomplete="new-password"
                    placeholder="Type it again"
                    data-i18n-placeholder="repeatPlaceholder"
                    minlength="<%= minLength %>"
                    required
                  />
                  <button type="button" class="eye-btn" aria-label="Show password" data-i18n-aria-label="showPassword" aria-pressed="false">
                    <svg class="eye-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                    <svg class="eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c6.5 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3.5 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg>
                  </button>
                </div>
              </label>

              <button type="submit" class="btn btn-primary auth-submit">
                <span data-i18n="resetSubmit">Set new password</span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </button>
              <button type="button" class="link-btn" id="reset-choose-channel" data-i18n="resetChooseChannel">Choose another recovery method</button>
            </form>

            <div class="error" id="reset-error" role="alert" hidden></div>

          </div>

          <div class="foot"><%= brand.name %> <span data-i18n="by">by</span> <%= brand.developer %> · <%= brand.studio %></div>
        </div>
      </section>
    </main>

    <script src="/gateway-i18n.js"></script>
    <script src="/gateway.js"></script>
    <script>
      (function () {
        var t = window.LevixGatewayI18n.t;

        // Android app: show the back-to-app button. Its label is already in
        // whichever language the page loaded in.
        var inApp = typeof window.LevixHost !== "undefined" && typeof window.LevixHost.closePanel === "function";
        if (inApp) {
          var backBtn = document.getElementById("login-back-app");
          if (backBtn) {
            backBtn.hidden = false;
            backBtn.addEventListener("click", function() { window.LevixHost.closePanel(); });
          }
        }

        var loginCard = document.getElementById("login-card");
        var resetCard = document.getElementById("reset-card");
        var channels = document.getElementById("reset-channels");
        var form = document.getElementById("reset-form");
        var errorBox = document.getElementById("reset-error");

        function showReset() {
          loginCard.hidden = true;
          resetCard.hidden = false;
        }
        function showLogin() {
          resetCard.hidden = true;
          loginCard.hidden = false;
          document.getElementById("forgot-link").focus();
        }
        var getT = function () {
          return window.LevixGatewayI18n ? window.LevixGatewayI18n.t : function (k) { return k; };
        };
        var currentErrorState = null;

        function renderCurrentError() {
          if (!currentErrorState) return;
          var t = getT();
          if (currentErrorState.type === "simple") {
            errorBox.textContent = t(currentErrorState.key, currentErrorState.vars);
          } else if (currentErrorState.type === "wrong_code") {
            var msg = t("resetErrWrongCode");
            if (currentErrorState.attemptsLeft) {
              msg += " " + t("resetErrAttemptsLeft", { n: currentErrorState.attemptsLeft });
            }
            errorBox.textContent = msg;
          } else if (currentErrorState.type === "invalid_password") {
            errorBox.textContent =
              window.LevixGatewayI18n && window.LevixGatewayI18n.lang === "ar"
                ? t("resetErrInvalidPassword")
                : currentErrorState.message || t("resetErrInvalidPassword");
          } else if (currentErrorState.type === "raw") {
            errorBox.textContent = currentErrorState.text;
          }
          errorBox.hidden = false;
        }

        function showErrorKey(key, vars) {
          currentErrorState = { type: "simple", key: key, vars: vars };
          renderCurrentError();
        }
        function showError(text) {
          currentErrorState = { type: "raw", text: text };
          renderCurrentError();
        }
        function hideError() {
          currentErrorState = null;
          errorBox.hidden = true;
        }

        window.addEventListener("levix-gateway-lang", renderCurrentError);
        window.addEventListener("levix-ui-prefs", renderCurrentError);
        window.addEventListener("storage", function (e) {
          if (e.key === "levix_lang") renderCurrentError();
        });

        async function postJson(url, body) {
          const controller = new AbortController();
          const timer = setTimeout(function () { controller.abort(); }, 20000);
          try {
            const response = await fetch(url, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(body || {}),
              signal: controller.signal,
            });
            return await response.json();
          } finally {
            clearTimeout(timer);
          }
        }

        document.getElementById("forgot-link").addEventListener("click", showReset);
        document.getElementById("reset-back").addEventListener("click", showLogin);

        document.addEventListener("keydown", function(e) {
          if (e.key === "Escape" && !resetCard.hidden) {
            showLogin();
          }
        });

        function setChannelBusy(busy) {
          var buttons = channels.querySelectorAll("[data-channel]");
          for (var i = 0; i < buttons.length; i += 1) buttons[i].disabled = busy;
        }

        function showSendError(result) {
          if (result.reason === "throttled") {
            showErrorKey("resetErrThrottled", { n: String(result.retryAfter || 60) });
          } else if (result.reason === "no_session") {
            showErrorKey("resetErrNoSession");
          } else if (result.reason === "send_failed") {
            showErrorKey("resetErrSendFailed");
          } else if (result.reason === "no_email") {
            showErrorKey("resetErrNoEmail");
          } else if (result.reason === "unverified") {
            showErrorKey("resetErrUnverified");
          } else if (result.reason === "locked") {
            showErrorKey("resetErrLocked");
          } else if (result.reason === "rate_limited") {
            if (result.retryAfter) showErrorKey("resetErrThrottled", { n: String(result.retryAfter) });
            else showErrorKey("resetErrRateLimited");
          } else if (result.reason === "unavailable") {
            showErrorKey("resetErrUnavailable");
          } else if (result.reason === "invalid") {
            showErrorKey("resetErrInvalid");
          } else {
            showErrorKey("resetErrStart");
          }
        }

        channels.addEventListener("click", async function (event) {
          var button = event.target.closest("[data-channel]");
          if (!button || button.disabled) return;
          var channel = button.getAttribute("data-channel");
          var lang = window.LevixGatewayI18n && window.LevixGatewayI18n.lang === "ar" ? "ar" : "en";
          setChannelBusy(true);
          hideError();
          try {
            const result = await postJson("/reset/request", { channel: channel, lang: lang });
            if (result.ok) {
              channels.hidden = true;
              form.hidden = false;
              document.getElementById("reset-code").focus();
            } else {
              showSendError(result);
            }
          } catch {
            showErrorKey("resetErrServer");
          }
          setChannelBusy(false);
        });

        var confirming = false;
        document.getElementById("reset-choose-channel").addEventListener("click", function () {
          if (confirming) return;
          form.hidden = true;
          channels.hidden = false;
          document.getElementById("reset-code").value = "";
          hideError();
        });
        form.addEventListener("submit", async function (event) {
          event.preventDefault();
          if (confirming) return;
          confirming = true;
          var submit = form.querySelector('[type="submit"]');
          submit.disabled = true;
          hideError();
          try {
            const result = await postJson("/reset/confirm", {
              code: document.getElementById("reset-code").value,
              password: document.getElementById("reset-pass").value,
              confirm: document.getElementById("reset-confirm").value,
            });
            if (result.ok) {
              form.hidden = true;
              channels.hidden = true;
              showErrorKey("resetDone");
              setTimeout(function () {
                window.location.href = "/";
              }, 900);
              return;
            }
            if (result.reason === "wrong_code") {
              currentErrorState = { type: "wrong_code", attemptsLeft: result.attemptsLeft };
              renderCurrentError();
            } else if (
              result.reason === "address_changed" ||
              result.reason === "expired" ||
              result.reason === "no_pending" ||
              result.reason === "too_many_attempts"
            ) {
              showErrorKey("resetErrExpired");
              form.hidden = true;
              channels.hidden = false;
            } else if (result.reason === "locked") {
              showErrorKey("resetErrLocked");
              form.hidden = true;
              channels.hidden = false;
            } else if (result.reason === "throttled") {
              showErrorKey("resetErrThrottled", { n: String(result.retryAfter || 60) });
            } else if (result.reason === "mismatch") {
              showErrorKey("resetErrMismatch");
            } else if (result.reason === "invalid_password") {
              currentErrorState = { type: "invalid_password", message: result.message };
              renderCurrentError();
            } else {
              showErrorKey("resetErrFailed");
            }
          } catch {
            showErrorKey("resetErrServer");
          } finally {
            confirming = false;
            submit.disabled = false;
          }
        });
      })();
    </script>
  </body>
</html>
