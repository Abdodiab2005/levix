<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= brand.name %> · First run</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/icon-32.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="stylesheet" href="/dashboard.css" />
    <style>
      body {
        display: grid;
        place-items: center;
        padding: 24px;
        background:
          radial-gradient(900px 500px at 15% -10%, rgba(22, 82, 240, 0.22), transparent 60%),
          radial-gradient(700px 420px at 90% 110%, rgba(33, 212, 253, 0.16), transparent 60%),
          var(--bg);
      }

      .login {
        width: 100%;
        max-width: 400px;
        text-align: center;
      }

      .login img {
        width: 190px;
        max-width: 70%;
        margin-bottom: 22px;
      }

      .login .card {
        text-align: left;
        padding: 24px;
      }

      .login h1 {
        font-size: 1.05rem;
        font-weight: 650;
        margin-bottom: 4px;
      }

      .login p.sub {
        color: var(--muted);
        font-size: 0.86rem;
        margin-bottom: 18px;
      }

      .login button {
        width: 100%;
        margin-top: 6px;
        padding: 11px;
      }

      .login .field {
        margin-bottom: 12px;
      }

      .error {
        margin-top: 12px;
        padding: 9px 12px;
        border-radius: var(--radius-sm);
        background: color-mix(in srgb, var(--danger) 14%, transparent);
        border: 1px solid color-mix(in srgb, var(--danger) 45%, transparent);
        color: var(--danger);
        font-size: 0.85rem;
        text-align: center;
      }

      .foot {
        margin-top: 20px;
        color: var(--faint);
        font-size: 0.78rem;
      }
    </style>
  </head>
  <body>
    <div class="login">
      <img src="/brand/wordmark.png" alt="<%= brand.name %>" />

      <form class="card" action="/setup" method="post">
        <h1>Welcome</h1>
        <p class="sub">
          Pick a password for the control panel. It is the only thing protecting a
          linked WhatsApp account, so make it a real one — at least
          <%= minLength %> characters.
        </p>

        <% if (needsCode) { %>
        <label class="field">
          <span>Setup code</span>
          <input type="text" name="code" autocomplete="off" autofocus required
                 placeholder="printed in the bot's terminal" />
        </label>
        <% } %>

        <label class="field">
          <span>Password</span>
          <input type="password" name="password" autocomplete="new-password"
                 minlength="<%= minLength %>" <%= needsCode ? "" : "autofocus" %> required />
        </label>

        <label class="field">
          <span>Repeat password</span>
          <input type="password" name="confirm" autocomplete="new-password"
                 minlength="<%= minLength %>" required />
        </label>

        <button type="submit" class="btn btn-primary">Create and sign in</button>

        <% if (error) { %>
        <div class="error"><%= error %></div>
        <% } %>
      </form>

      <div class="foot"><%= brand.name %> — <%= brand.tagline %> · by <%= brand.developer %></div>
    </div>
  </body>
</html>
